# Database
DATABASE_URL="postgresql://operadash:operadash@localhost:5432/operadash?schema=public"

# Redis (Socket.io adapter)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
NODE_ENV="development"
PORT="4000"
CORS_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"

# Stripe (test mode)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Email (welcome emails, password resets). Optional — if SMTP_HOST is unset,
# emails are logged instead of sent, so the app works without this locally.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="OperaDash <no-reply@operadash.com>"

# Seed / bootstrap
SUPER_ADMIN_EMAIL="admin@operadash.com"
SUPER_ADMIN_PASSWORD="SuperAdmin123!"
